{
    https_port {$HTTPS_PORT}
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

{$DOMAIN} {
    # --------------------------------------------------------
    # LET'S ENCRYPT CONFIGURATION
    # --------------------------------------------------------
    tls {$EMAIL} {
        # DEVIL'S ADVOCATE TIP: 
        # If your DNS is still propagating, UNCOMMENT the line below to use 
        # the staging server so you don't get rate-limited during testing.
        # Once testing is done, comment it out and restart Caddy.
        # ca https://acme-staging-v02.api.letsencrypt.org/directory
        dns desec {
            token "{env.DESEC_API_KEY}"
        }

        resolvers 9.9.9.9 149.112.112.112
        propagation_delay 150s
        propagation_timeout 450s
    
    }

    # Compress responses to save bandwidth on the free tier
    encode zstd br gzip

    # --------------------------------------------------------
    # EDGE SECURITY HEADERS
    # --------------------------------------------------------
    header {
        # Hide the server signature from automated scanner bots
        -Server

        # Enforce HTTPS strictly for 1 year (HSTS)
        Strict-Transport-Security "max-age=31536000;"

        # Prevent MIME-sniffing attacks
        X-Content-Type-Options "nosniff"
    }

    # --------------------------------------------------------
    # REVERSE PROXY
    # --------------------------------------------------------
    # Vaultwarden version 1.30.0+ natively handles WebSockets on port 80.
    # Caddy v2 proxies WebSockets automatically, so no extra config is needed here.

    reverse_proxy {$APP_UPSTREAM} {
        flush_interval -1
    }
}
